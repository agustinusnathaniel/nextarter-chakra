{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", "group:all"],
  "major": {
    "enabled": false
  },
  "updatePinnedDependencies": false,
  "stabilityDays": 2,
  "vulnerabilityAlerts": {
    "stabilityDays": 0,
    "rangeStrategy": "bump",
    "labels": ["security"]
  },
  "timezone": "Asia/Jakarta",
  "schedule": ["before 1am on Monday"],
  "rangeStrategy": "bump",
  "ignoreDeps": ["node", "pnpm"]
}
