{
  "name": "nextarter-chakra",
  "version": "0.1.0",
  "private": true,
  "author": "agustinusnathaniel",
  "scripts": {
    "biome:ci": "biome ci",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "build:turbo": "pnpm turbo run build",
    "check:turbo": "pnpm turbo ultracite:check type:check",
    "dev": "next dev",
    "prepare": "husky",
    "push-release": "git push --follow-tags origin main",
    "release": "cross-env HUSKY=0 commit-and-tag-version",
    "start": "next start",
    "test:e2e": "playwright test",
    "turbo": "pnpm dlx turbo@2.6.1",
    "type:check": "tsc --noEmit",
    "ultracite:check": "ultracite check",
    "ultracite:fix": "ultracite fix",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "commit-and-tag-version": "^13.1.2",
    "knip": "^6.34.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@chakra-ui/cli": "^3.37.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/cz-commitlint": "21.2.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "next-sitemap": "^4.2.3",
    "typescript": "~7.0.2",
    "ultracite": "7.10.6"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^24.11.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  }
}
